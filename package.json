{
  "name": "jobsentry-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade AI-powered Job Verification & Recruitment Intelligence Platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:studio": "pnpm --filter api db:studio"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "@types/node": "^22.13.9",
    "prettier": "^3.5.3",
    "zod": "^3.24.2"
  },
  "packageManager": "pnpm@12.21.0"
}
